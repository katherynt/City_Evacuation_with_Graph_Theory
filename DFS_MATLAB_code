clear;
clc;

%%----INPUTS----%%

matrix = [0	10	14	10	10	0	0	0 ; 
0	0	0	0	0	10	0	0 ; 
0	9	0	2	3	0	0	0 ; 
0	5	2	0	3	0	0	0 ; 
0	0	0	0	0	0	10	0 ; 
0	0	0	0	0	0	0	10 ; 
0	0	0	0	0	0	0	10 ; 
0	0	0	0	0	0	0	0  ];% INPUT matrix representing network flow capacities. 

source = 1; sink=8; % INPUT source and sink in context of position of matrix.

%%--------------%%

%% Initialisation before looping.
residual=matrix;

n=size(matrix,1); % Store size of matrix.

flow_total=0; % Initalise store of flows in each iteration.
 
iter=1; % Initialise an iteration count as 1.
iter_max = sum(matrix(source,:)); % Set maximum number of iterations to the net outward flow capacity of the source.

found = false; % Initialise found flag to false.

while iter<iter_max % Complete method within a while loop with capped iterations. 

%% Perform Depth-First Path Search

visited = false(1,n);
parent  = zeros(1,n);

stack = source; % Initialise stack set.
visited(source) = true;

found_path = false; %Initalise found_path logic as false.
path = [];  % Initalise path as empty.

while ~isempty(stack) %Update stack until empty         

    visiting = stack(1); % Visit the first element of the stack.
    stack(1) = []; % Remove the chosen vertex from the stack.

    if visiting == sink % If we've reached the sink, stop searching
        found_path = true;
        break
    end

    for i = 1:n
        if residual(visiting,i) > 0 && ~visited(i) %Test for path advancement though visiting vertex.
            visited(i) = true;
            parent(i)  = visiting;

            stack = [i stack]; % Add neighbour to front of stack.

        end
    end
end

% Reconstruct the path using parent pointers (only if path found).
if found_path
    v = sink;
    path = sink;

    while v ~= source
        v = parent(v);
        path = [v path];
    end
end

if ~found_path
    break   % No augmenting path end Ford-Fulkerson method
end

%% Perform iteration of the Ford-Fulkerson Method with identified path.

path_n=length(path); % Record the length of the path.

if found % Break F-F method if stopping condition was met in path searching above. 
   break
end

% Store flow capacities of edges in path with a for loop.
flow_cap=[];
for z=1:path_n-1  
flow_cap(z)=residual(path(z),path(z+1));
end

flow_it=min(flow_cap); % Identify and record the minimum flow capacity in the path.
flow_total=flow_total+flow_it; % Update the total capacity found.

% Update the residual graph.
for z=1:path_n-1
residual(path(z),path(z+1))=residual(path(z),path(z+1))-flow_it; % Subtract flow_it from each flow capactity in the path.
residual(path(z+1),path(z))=residual(path(z+1),path(z))+flow_it; % Add flow_it to each reverse flow capacity in the path.
end

iter=iter+1; % Increase count of iterations by one.

end % End primary while loop.

%% Present results for maximum flow.
 
if iter==iter_max % Check if method was terminated with no result.
fprintf('The decided maximum number of iterations was met before the Ford-Fulkerson method reached final result for maximum flow.')
return % End method implementation.

else % Otherwise, a solution was found.
fprintf('The maximum flow through this network is %d.' , flow_total')

end

%%% Calculate minimum cut with BFS.

S(1)=source; % Store source vertex in S. 
queue(1)=source; %initialise queue with only the source.

while ~isempty(queue) % Iterate BFS to find set S until queue is empty.

vis_it=queue(1); % Visit first in queue.
queue(queue==vis_it)=[]; % Update queue to remove vertex being visited.

for i=1:n

if residual(vis_it,i)>0 && ~ismember(i,S) % Test if each neighbour of current vertex is reachable and not listed in S.
    S=[S i]; % Update list of reachable vertices from S where applicable. 
    queue=[queue i]; % Add new reachable vertices to the queue. 
end 
end 
end 

all_vertices = 1:n; % Store set of all vertices in the matrix.
T = all_vertices(~ismember(all_vertices, S)); % Store the set of all vertices in the matrix which are not in S.

cut_set=[]; % Initalise cut set as empty.
for visiting_S=S 
    for visiting_T=T
    if matrix(visiting_S,visiting_T)>0 % Test each combination of vertices in S and T for positive capacity in matrix.
        cut_set= [cut_set; visiting_S visiting_T]; %Add those identified to cut-set.
    end 
    end 
end 


%% Present Min-cut set
cut_set_n=size(cut_set,1);

fprintf('The minimum cut set for this network is: ');
if cut_set_n==1
    fprintf('(%d,%d).', cut_set(i,1), cut_set(i,2)); 
else

for i = 1:cut_set_n
        if i == cut_set_n
           fprintf('(%d,%d).', cut_set(i,1), cut_set(i,2)); 
           else
           fprintf('(%d,%d),', cut_set(i,1), cut_set(i,2));
        end 
        
end %Output split into different cases of cut_set position for correct grammer. 
end
