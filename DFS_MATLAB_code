clear;
clc;

%%----INPUTS----%%

residual = [
0	5	4	0;
0	0	3	2;
0	0	0	0;
0	0	0	0; ]; % INPUT residual matrix corresponding to current flow state.

source = 1; sink=4; % INPUT source and sink in context of position of matrix.


population=100;
%%--------------%%

%% Initialisation before looping.
n=size(residual,1); % Store size of matrix.

visited=false(1,n);
parent=zeros(1,n);

stack=source; % Initialise stack set.
visited(source)=true;

found_path=false; %Initalise found_path logic as false.
path=[]; % Initalise path as empty.

%% Perform Depth-First Path Search

while ~isempty(stack) %Update stack until empty         

    visiting=stack(1); % Visit the first element of the stack.
    stack(1)=[]; % Remove the chosen vertex from the stack.

    if visiting==sink % If we've reached the sink, stop searching
        found_path=true;
        break
    end

    for i=1:n
        if residual(visiting,i)>0 && ~visited(i) %Test for path advancement though visiting vertex.
            parent(i)=visiting;
            visited(i)=true;
       
            stack=[i stack]; % Add neighbour to front of stack.

        end
    end
end

%% Path reconstruction with parent function.
if found_path %Only if path found. 
    
    v=sink; %Seach backwards from sink.
    path=sink; %Add sink to path.

    while v~=source
        v=parent(v);
        path=[v path]; %Update with parent from front.
    end
end

%Print result
if found_path
    fprintf('A s-t path in this graph calculated with depth-first searching is: P(s,t)=(%s).\n', strjoin(string(path), ','));
else
    fprintf('No s-t path exists.\n');
end
